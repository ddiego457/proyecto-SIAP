# Variables de entorno de SIAP — plantilla
# Copie este archivo a /.env (que no se versiona) y complete los valores.

# ── Envío de correo (SMTP) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Administrador SIAP

# ── Plantillas de correo ──────────────────────────────────────
# Asunto del correo de recuperación de contraseña
MAIL_SUBJECT_RECUPERACION=Recuperación de contraseña — SIAP
# Plantilla usada (archivo app/template/mail/<valor>.php)
MAIL_TEMPLATE_RECUPERACION=recuperacion
